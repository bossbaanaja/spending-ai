{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spending-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Cloudflare cron uses UTC: 22:00 UTC is 05:00 the next day in Thailand.
    "crons": ["0 22 * * *"]
  },
  "vars": {
    // Fallback chain, tried left to right (see nim.ts modelRotation). Retries
    // rotate through the whole list; the hedged slip parse races two requests
    // starting half a list apart so they land in different NIM queues. Add or
    // swap an entry here when a catalog ID changes — no code change needed.
    //
    // Ordered by measured health, re-tested 2026-08-11 (3 slip parses + one
    // tool call each, against the live catalog):
    //   minimax-m3          3/3 correct, 1.5-18s, tool calls OK  <- best
    //   gpt-oss-120b        2/3 correct, 21-86s,  tool calls OK
    //   nemotron-3-super    2/3 correct, 21-34s,  tool calls OK
    //   gemma-4-31b-it      1/6 correct, mostly HTTP 500 — but fails in ~1s,
    //                       so it costs almost nothing to have it in the list
    //   glm-5.2             answers, but took 132s once and timed out 8/9;
    //                       demoted from first place, kept as a late resort
    //   llama-3.2-90b-vis   0/8, times out every call — last on purpose: a
    //                       timeout burns ~45s of the 60s retry cap, so this
    //                       one must never be reached before a working model
    //
    // Dropped 2026-08-11: deepseek-v4-pro and deepseek-v4-flash both return
    // HTTP 410 (end-of-life 2026-08-07) and are gone from the catalog.
    "NIM_MODELS": "minimaxai/minimax-m3,openai/gpt-oss-120b,nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it,z-ai/glm-5.2,meta/llama-3.2-90b-vision-instruct"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spending_ai",
      "database_id": "2280617b-c06b-434e-bbe6-d98d4eb0a4d4"
    }
  ]
}
