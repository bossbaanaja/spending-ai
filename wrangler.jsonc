{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spending-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Cloudflare cron uses UTC: 22:00 UTC is 05:00 the next day in Thailand.
    "crons": ["0 22 * * *", "* * * * *"]
  },
  "vars": {
    // Empty = legacy intake. Comma-separated Telegram IDs = canary. '*' = all.
    "ALBUM_QUEUE_USERS": "",
    // Fallback chain, tried left to right (see nim.ts modelRotation). Retries
    // rotate through the whole list; the hedged slip parse races two requests
    // starting half a list apart so they land in different NIM queues. Add or
    // swap an entry here when a catalog ID changes — no code change needed.
    //
    // Ordered by measured health, re-tested 2026-09-17 (live catalog & slip tests):
    //   nemotron-3-super    1/1 correct, ~7.2s, clean JSON        <- rank 1 (best)
    //   deepseek-v4-flash   1/1 correct, ~6.6s, clean JSON        <- rank 2 (fast backup)
    //   gpt-oss-20b         1/1 correct, ~20.0s, clean JSON       <- rank 3 (reasoning backup)
    //   nemotron-3.5-light  ping fast (~1.2s), reasoning output   <- rank 4
    //   gemma-4-31b-it      stalled queue                         <- rank 5
    //   llama-3.2-90b-vis   stalled queue                         <- rank 6
    //   llama-3.2-11b-vis   stalled queue                         <- rank 7
    //
    // Dropped 2026-09-16: minimax-m3 (EOL 2026-09-09), gpt-oss-120b (EOL 2026-09-03), glm-5.2 (EOL 2026-08-21)
    "NIM_MODELS": "nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4-flash-0731,openai/gpt-oss-20b,nvidia/nemotron-3.5-lightning-30b-a3b,google/gemma-4-31b-it,meta/llama-3.2-90b-vision-instruct,meta/llama-3.2-11b-vision-instruct"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spending_ai",
      "migrations_dir": "src/db/migrations",
      "database_id": "2280617b-c06b-434e-bbe6-d98d4eb0a4d4"
    }
  ],
  "queues": {
    "producers": [{ "binding": "ALBUM_QUEUE", "queue": "spending-ai-albums" }],
    "consumers": [{ "queue": "spending-ai-albums", "max_batch_size": 1,
      "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 3,
      "dead_letter_queue": "spending-ai-albums-failed" }]
  }
}
